{
  "git_panel": {
    "sort_by": "name",
    "group_by": "staging",
    "tree_view": true
  },
  "icon_theme": "Zed (Default)",
  "session": {
    "trust_all_worktrees": true
  },
  "base_keymap": "VSCode",
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-sol"
      },
      "type": "registry"
    }
  },
  "features": {
    "inline_completion_provider": "copilot"
  },
  "project_panel": {
    "dock": "right"
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "restore_on_startup": "last_session",
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night",
    "dark": "Tokyo Night"
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "indent_aware",
    "background_coloring": "indent_aware"
  },
  "languages": {
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true
      }
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    }
  }
}
